# Jetson (JetPack 6) image: ROS 2 Humble plus the camera stack the vision package needs
# (librealsense with Python bindings, CUDA torch, ultralytics). Ported from sailbot's
# setup/Dockerfile. The plain Dockerfile stays the development and CI image.
#
#   docker build -f jetson/setup/Dockerfile.jetson -t boat-jetson jetson/setup
FROM nvcr.io/nvidia/l4t-base:r36.2.0

ENV DEBIAN_FRONTEND=noninteractive

# Locale and timezone
RUN apt-get update && apt-get install -y --no-install-recommends locales tzdata \
    && locale-gen en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && ln -fs /usr/share/zoneinfo/UTC /etc/localtime \
    && dpkg-reconfigure --frontend noninteractive tzdata \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8

# ROS 2 Humble, colcon and rosbridge
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg2 lsb-release software-properties-common \
    && add-apt-repository universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
    > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    python3-pip \
    python3-pytest \
    ros-dev-tools \
    ros-humble-ros-base \
    ros-humble-rosbridge-server \
    && rm -rf /var/lib/apt/lists/*
ENV ROS_DISTRO=humble

# librealsense with Python bindings, built from source for ARM64
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config \
    libusb-1.0-0-dev libglfw3-dev libgtk-3-dev libgl1-mesa-dev libssl-dev \
    python3-dev python3-numpy \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/IntelRealSense/librealsense.git /tmp/librealsense \
    && cmake -S /tmp/librealsense -B /tmp/librealsense/build \
    -DBUILD_PYTHON_BINDINGS=ON \
    -DPYTHON_EXECUTABLE=/usr/bin/python3 \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_GRAPHICAL_EXAMPLES=OFF \
    -DFORCE_LIBUVC=ON \
    && cmake --build /tmp/librealsense/build -j"$(nproc)" \
    && cmake --install /tmp/librealsense/build \
    && ldconfig \
    && rm -rf /tmp/librealsense

# CUDA torch for JetPack 6 and YOLO
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates wget libopenblas-dev libblas-dev liblapack-dev \
    && wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/arm64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm cuda-keyring_1.1-1_all.deb \
    && apt-get update && apt-get install -y cudss \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir torch torchvision \
    --index-url https://pypi.jetson-ai-lab.io/jp6/cu126
RUN pip3 install --no-cache-dir ultralytics "numpy<2"

# Workspace, Python requirements and startup script, as in the development image
WORKDIR /home/ros2_user/ros2_ws
COPY requirements.txt ./requirements.txt
RUN pip3 install --no-cache-dir -r requirements.txt
ENV DEBIAN_FRONTEND=

COPY setup_ros.sh /home/ros2_user/setup_ros.sh
RUN chmod +x /home/ros2_user/setup_ros.sh \
    && printf '\nsource /opt/ros/humble/setup.bash\nif [ -f /home/ros2_user/ros2_ws/install/setup.bash ]; then source /home/ros2_user/ros2_ws/install/setup.bash; fi\n' >> /etc/bash.bashrc

ENTRYPOINT ["/home/ros2_user/setup_ros.sh"]
CMD ["bash"]
